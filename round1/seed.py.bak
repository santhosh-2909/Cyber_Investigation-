# ---------------------------------------------------------------------------
# Seed routine
# ---------------------------------------------------------------------------

def seed(reset=False):
    if reset:
        db.reset_db()
    else:
        db.init_db()

    conn = db.get_connection()
    try:
        # Insert categories and remember their DB ids / codes
        cat_id_by_code = {}
        for cat in CATEGORIES:
            cur = conn.execute(
                "INSERT OR IGNORE INTO challenge_categories "
                "(challenge_code, title, domain, description, difficulty, points, active) "
                "VALUES (?,?,?,?,?,?,1)",
                (cat["code"], cat["title"], cat["domain"], cat["description"],
                 cat["difficulty"], cat["points"]),
            )
            # get id (either new or existing)
            row = conn.execute(
                "SELECT id FROM challenge_categories WHERE challenge_code=?",
                (cat["code"],),
            ).fetchone()
            cat_id_by_code[cat["code"]] = row["id"]

        # Insert variants
        for code, variants in VARIANTS.items():
            clist = VARIANTS[code]
            assert len(clist) == 4, f"Category {code} must have exactly 4 variants (got {len(clist)})"
            cat_id = cat_id_by_code[code]
            for i, v in enumerate(clist, start=1):
                flag = generate_secret_flag(len(CATEGORIES) * (i))
                conn.execute(
                    "INSERT OR IGNORE INTO challenge_variants "
                    "(challenge_category_id, variant_code, question, task_description, "
                    "provided_data, expected_answer, flag, difficulty, hint, explanation, "
                    "estimated_solve_time) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                    (cat_id, v["v"], v["question"], v["task_description"],
                     v["provided_data"], v["expected_answer"], flag,
                     v["difficulty"], v["hint"], v["explanation"], v["eta"]),
                )
        conn.commit()
        num_variants = sum(len(v) for v in VARIANTS.values())
        print(f"Seeded {len(CATEGORIES)} categories and {num_variants} variants.")

        # Create / verify default admin account
        conn.execute(
            "INSERT OR IGNORE INTO admins (username, password_hash) VALUES (?,?)",
            (DEFAULT_ADMIN_USERNAME,
             generate_password_hash(DEFAULT_ADMIN_PASSWORD)),
        )
        conn.commit()
        print(f"Admin account ready: username='{DEFAULT_ADMIN_USERNAME}', "
              f"password='{DEFAULT_ADMIN_PASSWORD}'")
    finally:
        conn.close()


if __name__ == "__main__":
    reset_flag = "--reset" in sys.argv
    seed(reset=reset_flag)
